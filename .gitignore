# Nothing credential-shaped, ever. Secrets live outside every git tree.
.env
.env.*
*.pem
*.key

# Generated by build.mjs and rebuilt in CI before every deploy. Committing them
# would mean reviewing diffs of output nobody wrote.
/index.html
/sitemap.xml
/sw.js

# Local noise
node_modules/
.DS_Store
Thumbs.db
*.log
